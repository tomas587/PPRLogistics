ENTRA_TENANT_ID=your-microsoft-entra-tenant-id
ENTRA_CLIENT_ID=your-microsoft-entra-application-client-id
# Configure ONE authentication method:
ENTRA_CLIENT_SECRET=your-client-secret-if-not-using-a-certificate
# Or use a certificate registered on the Entra app (private key in PEM format):
ENTRA_CERTIFICATE_PRIVATE_KEY=your-private-key-PEM-with-newlines
ENTRA_CERTIFICATE_THUMBPRINT=base64url-or-40-character-hex-sha1-thumbprint
SENDER_MAILBOX=authorized-company-mailbox@yourdomain.com
CONTACT_EMAIL=Info@pprlogistics.net
FRONTEND_URL=https://your-production-domain.com
